<!-- settings.dblind.xml -->

<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
   https://maven.apache.org/xsd/settings-1.0.0.xsd">
   <localRepository/>
   <interactiveMode/>
   <usePluginRegistry/>
   <offline/>
   <pluginGroups>
       <pluginGroup>org.mule.tools</pluginGroup>
   </pluginGroups>
   <servers>
       <server>
           <id>anypoint-exchange</id>
           <username>${anypoint_username}</username>
           <password>${anypoint_password}</password>
       </server>
       <server>
           <id>exchange-server</id>
           <username>${anypoint_username}</username>
           <password>${anypoint_password}</password>
       </server>

       <!-- Any Pulbic access token from your github account can be used here. If you don't have a Github acccount, 
       please contact dblind mulesoftconnector@ztensor.com to get an access token. -->
        <server>
           <id>datablindrepo</id>
           <!--<username>~~~~~Token~~~~~</username> -->
           <username>${dblrepo_username}</username>           
           <password>${dblrepo_password}</password>
       </server>
       <!-- <server>
        <id>MuleRepository</id>
        <username>${muleentrepo_username}</username>
        <password>${muleentrepo_password}</password>
       </server> -->
   </servers>
   <mirrors/>
   <profiles>
       <profile>
           <id>mule-extra-repos</id>
           <activation>
               <activeByDefault>true</activeByDefault>
           </activation>
           <repositories>
               <repository>
                   <id>mule-public</id>
                   <url>https://repository.mulesoft.org/nexus/content/repositories/public</url>
               </repository>
           </repositories>
           <pluginRepositories>
               <pluginRepository>
                   <id>mule-public</id>
                   <url>https://repository.mulesoft.org/nexus/content/repositories/public</url>
               </pluginRepository>
           </pluginRepositories>
       </profile>
   </profiles>
   <activeProfiles>
       <activeProfile>mule-extra-repos</activeProfile>
   </activeProfiles>
</settings>
